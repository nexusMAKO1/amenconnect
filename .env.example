# ==========================================
# AmenConnect Docker Compose Environment Configuration
# ==========================================

# ------------------------------------------
# General Environment
# ------------------------------------------
NODE_ENV=production

# ------------------------------------------
# Security & Authentication (Required in Production)
# ------------------------------------------
JWT_SECRET=super_secret_jwt_key_amenconnect_change_me_in_production
SESSION_SECRET=super_secret_session_key_amenconnect_change_me

# ------------------------------------------
# Mailer Configuration (Nodemailer for 2FA OTP & Password Resets)
# ------------------------------------------
EMAIL_USER=noreply@amenbank.com.tn
EMAIL_PASS=smtp_app_password_here

# ------------------------------------------
# Together AI Configuration (AmenBot LLM Inference)
# ------------------------------------------
TOGETHER_API_KEY=your_together_ai_api_key_here
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ------------------------------------------
# Green API (WhatsApp Gateway for Banking Assistant)
# ------------------------------------------
GREEN_API_INSTANCE_ID=7105220307
GREEN_API_TOKEN=2d101b287231477aaca87eab7dc79a21c20cb9f645774691a6

# ------------------------------------------
# Hardware Totem Emulation
# ------------------------------------------
KIOSK_SERIAL_NUMBER=KIOSK-DOCKER-001

# ------------------------------------------
# Ports Configuration
# ------------------------------------------
BACKEND_PORT=3000
BOT_PORT=5050
HARDWARE_PORT=5001
CLIENT_PORT=8100
KIOSK_PORT=8200
MONGO_PORT=27018

