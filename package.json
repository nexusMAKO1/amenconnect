{
  "name": "amenconnect-ecosystem",
  "version": "1.0.0",
  "description": "AmenConnect - Omnichannel Digital Banking & Smart Self-Service Kiosk Terminal Ecosystem",
  "private": true,
  "scripts": {
    "start:backend": "cd Backend && npm run start",
    "dev:backend": "cd Backend && npm run dev",
    "dev:client": "cd AmenConnect && npm run dev",
    "dev:kiosk": "cd AmenKiosk && npm run dev",
    "dev:bot": "cd bot && python3 app.py",
    "dev:daemon": "python3 api.py",
    "build:client": "cd AmenConnect && npm run build",
    "build:kiosk": "cd AmenKiosk && npm run build",
    "build:all": "npm run build:client && npm run build:kiosk",
    "install:all": "cd Backend && npm install && cd ../AmenConnect && npm install && cd ../AmenKiosk && npm install"
  },
  "dependencies": {
    "@capacitor/device": "^7.0.0",
    "@ionic/react": "^8.4.3",
    "@types/leaflet": "^1.9.17",
    "@types/leaflet.markercluster": "^1.5.5",
    "framer-motion": "^12.0.11",
    "ionicons": "^7.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.0.0",
    "react-router-dom": "^5.3.4",
    "react-simple-keyboard": "^3.8.57",
    "recharts": "^2.15.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^19.0.8",
    "@types/react-router-dom": "^5.3.3"
  }
}
