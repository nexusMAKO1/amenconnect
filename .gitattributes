# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.jar binary
*.keystore binary
*.jks binary
*.pdf binary

# Linguist overrides
package-lock.json linguist-generated=true
