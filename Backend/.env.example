# ==========================================
# AmenConnect Backend Environment Configuration
# ==========================================

# Server Settings
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (comma-separated or single URL)
CLIENT_ORIGIN=http://localhost:8100

# Database Configuration
MONGO_URI=mongodb://localhost:27017/amenconnect

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
SESSION_SECRET=your_session_secret_change_in_production

# Mailer Configuration (Nodemailer for OTP & password reset)
EMAIL_USER=your_email@amenbank.com.tn
EMAIL_PASS=your_email_app_password

# External AI & Python Bot Services
FLASK_API_URL=http://localhost:5000
TOGETHER_API_KEY=your_together_ai_api_key

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
